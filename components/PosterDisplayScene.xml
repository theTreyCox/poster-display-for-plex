<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterDisplayScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/PosterDisplayScene.brs" />
    <children>
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x000000FF" />

        <Poster
            id="backgroundPoster"
            width="1920"
            height="1080"
            translation="[0,0]"
            loadDisplayMode="zoomToFill"
            opacity="0.18"
            visible="false" />

        <!-- Optional black matte rendered behind the portrait poster (no-theater-frame
             modes only). Four rects so each side can be individually hidden — when info
             is on, the viewer-bottom side hides because the chrome strip already provides
             that black band. Geometry set in BRS to follow the poster's rotation + center. -->
        <Group id="portraitPosterBorderGroup" visible="false">
            <Rectangle id="portraitPosterBorderTop" color="0x000000FF" />
            <Rectangle id="portraitPosterBorderBottom" color="0x000000FF" />
            <Rectangle id="portraitPosterBorderLeft" color="0x000000FF" />
            <Rectangle id="portraitPosterBorderRight" color="0x000000FF" />
        </Group>

        <Poster
            id="poster"
            width="1920"
            height="1080"
            translation="[0,0]"
            loadDisplayMode="scaleToFit" />

        <Poster
            id="borderLandscape"
            uri="pkg:/images/borders/landscape/landscape-border-01.png"
            width="1920"
            height="1080"
            translation="[0,0]"
            visible="false"
            loadDisplayMode="scaleToFill" />

        <Poster
            id="borderPortrait"
            uri="pkg:/images/borders/portrait/portrait-border-01.png"
            width="1920"
            height="1080"
            translation="[0,0]"
            visible="false"
            loadDisplayMode="scaleToFill" />

        <!-- =============== LANDSCAPE INFO STRIP (left side, vertical) ===============
             400px-wide solid-black strip pinned to the left of the screen. Mirrors
             the metadata strip on the right. Stacks (top to bottom): rating icon,
             title, year, then later in the strip: clock, time row, progress bar. -->
        <Group id="landscapeChrome">
            <Rectangle id="overlay" width="400" height="1080" color="0x000000FF" />

            <!-- Rating icon (top, centered horizontally) -->
            <Poster
                id="ratingIcon"
                visible="false"
                translation="[170, 50]"
                width="60"
                height="60"
                opacity="0.9"
                loadDisplayMode="scaleToFit" />
            <!-- Text rating prefix (used only when no PNG icon is available) -->
            <Label
                id="nowPlayingPrefix"
                visible="false"
                translation="[20, 50]"
                width="360"
                height="60"
                text=""
                color="0xFFFFFFCC"
                horizAlign="center"
                vertAlign="center"
                font="font:LargeBoldSystemFont" />

            <!-- Title (wraps; centered in strip) -->
            <Label
                id="nowPlayingTitle"
                visible="false"
                translation="[20, 140]"
                width="360"
                height="180"
                text=""
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="top"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="36" />
            </Label>

            <!-- Year (below title) -->
            <Label
                id="nowPlayingYear"
                visible="false"
                translation="[20, 340]"
                width="360"
                height="44"
                text=""
                color="0xFFFFFFCC"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="36" />
            </Label>

            <!-- "Waiting for Plex" / setup prompt (replaces title row when not playing) -->
            <Label
                id="messageLabel"
                translation="[20, 460]"
                width="360"
                height="160"
                text="Waiting for Plex"
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>

            <!-- Clock (large, centered, lower portion of strip) -->
            <Label
                id="clockLabel"
                translation="[20, 700]"
                width="360"
                height="80"
                text=""
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="72" />
            </Label>

            <!-- Progress: current time on left, total on right, bar below -->
            <Group id="progressGroup" visible="false" translation="[20, 820]">
                <Label
                    id="currentTimeLabel"
                    translation="[0, 0]"
                    width="170"
                    height="40"
                    text="0:00:00"
                    color="0xFFFFFFFF"
                    horizAlign="left"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="30" />
                </Label>
                <Label
                    id="totalTimeLabel"
                    translation="[190, 0]"
                    width="170"
                    height="40"
                    text="0:00:00"
                    color="0xFFFFFFFF"
                    horizAlign="right"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="30" />
                </Label>
                <Rectangle translation="[0, 50]" width="360" height="8" color="0x666666FF" />
                <Rectangle id="progressBarFill" translation="[0, 50]" width="1" height="8" color="0xFFA500FF" />
            </Group>

            <!-- Settings icon (still pinned to the screen's top-right corner) -->
            <Rectangle width="60" height="60" translation="[1840, 20]" color="0x000000FF" />
            <Button
                id="settingsButton"
                translation="[1840, 20]"
                minWidth="60"
                height="60"
                text="≡"
                textColor="0xFFD700FF"
                focusedTextColor="0xFFEE00FF"
                showFocusFootprint="false">
                <Font role="textFont" uri="pkg:/fonts/Oswald-Bold.ttf" size="36" />
            </Button>
        </Group>

        <!-- =============== PORTRAIT CHROME (rotated) =============== -->
        <Group id="portraitChrome" visible="false" translation="[1265, 425]"
               rotation="1.5707963" scaleRotateCenter="[540, 115]">
            <!-- 1080x230 pre-rotation; becomes 230x1080 buffer-edge strip; viewer sees as bottom 230 of vertical screen -->
            <Rectangle width="1080" height="230" color="0x000000FF" />

            <!-- Progress bar (top of strip in viewer). Layout:
                 [current] [ bar ] [total]   plus a sibling clock label below. -->
            <Group id="portraitProgressGroup" visible="false" translation="[0, 50]">
                <Label
                    id="portraitCurrentTimeLabel"
                    translation="[90, 0]"
                    width="90"
                    height="32"
                    text="0:00"
                    color="0xFFFFFFFF"
                    horizAlign="left"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
                </Label>
                <Rectangle translation="[200, 12]" width="690" height="8" color="0x666666FF" />
                <Rectangle id="portraitProgressBarFill" translation="[200, 12]" width="1" height="8" color="0xFFA500FF" />
                <Label
                    id="portraitTotalTimeLabel"
                    translation="[900, 0]"
                    width="90"
                    height="32"
                    text="0:00"
                    color="0xFFFFFFFF"
                    horizAlign="right"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
                </Label>
            </Group>

            <!-- Status (centered in strip when shown alone). When playing+info, the
                 now-playing row + clock sit at y=132 (vertically centered as a group
                 with the progress bar above); the message label hides. -->
            <Label
                id="portraitMessageLabel"
                translation="[20, 91]"
                width="1040"
                height="48"
                text="Waiting for Plex"
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>
            <Label
                id="portraitNowPlayingPrefix"
                visible="false"
                translation="[20, 132]"
                width="120"
                height="48"
                text=""
                color="0xFFFFFFCC"
                horizAlign="left"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>
            <Poster
                id="portraitRatingIcon"
                visible="false"
                translation="[20, 132]"
                width="72"
                height="48"
                opacity="0.85"
                loadDisplayMode="scaleToFit" />
            <Label
                id="portraitNowPlayingTitle"
                visible="false"
                translation="[150, 132]"
                width="640"
                height="48"
                text=""
                color="0xFFFFFFFF"
                horizAlign="left"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>
            <Label
                id="portraitNowPlayingYear"
                visible="false"
                translation="[150, 132]"
                width="160"
                height="48"
                text=""
                color="0xFFFFFFCC"
                horizAlign="left"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
            </Label>
            <Label
                id="portraitClockLabel"
                translation="[790, 132]"
                width="200"
                height="48"
                text=""
                color="0xFFFFFFFF"
                horizAlign="right"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="32" />
            </Label>

            <!-- Settings icon (right side of strip in viewer) -->
            <Rectangle id="portraitSettingsButtonBg" width="60" height="60" translation="[1010, 126]" color="0x000000FF" />
            <Button
                id="portraitSettingsButton"
                translation="[1010, 126]"
                minWidth="60"
                height="60"
                text="≡"
                textColor="0xFFD700FF"
                focusedTextColor="0xFFEE00FF"
                showFocusFootprint="false">
                <Font role="textFont" uri="pkg:/fonts/Oswald-Bold.ttf" size="36" />
            </Button>
        </Group>

        <!-- =============== LANDSCAPE METADATA (right-side vertical strip) ===============
             Horizontal padding matches the info chrome on the left (20px each side).
             Slogan + stats + summary; director dropped. -->
        <Group id="landscapeMetadata" visible="false" translation="[1520, 0]">
            <Rectangle width="400" height="1080" color="0x000000FF" />
            <!-- Slogan / tagline (accent color, uppercase, Oswald Bold) -->
            <Label
                id="landscapeMetaTagline"
                translation="[20, 80]"
                width="360"
                height="200"
                text=""
                color="0xFFA500FF"
                horizAlign="left"
                vertAlign="top"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="38" />
            </Label>
            <!-- Year · Runtime · Genres — BebasNeue-Regular @ 80% opacity (CC alpha) -->
            <Label
                id="landscapeMetaStats"
                translation="[20, 310]"
                width="360"
                height="46"
                text=""
                color="0xFFFFFFCC"
                horizAlign="left"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="35" />
            </Label>
            <!-- Description (smaller body font) -->
            <Label
                id="landscapeMetaSummary"
                translation="[20, 391]"
                width="360"
                height="540"
                text=""
                color="0xE5E5E5FF"
                horizAlign="left"
                vertAlign="top"
                font="font:SmallestSystemFont"
                wrap="true" />
            <Label
                id="landscapeMetaReadMoreHint"
                visible="false"
                translation="[20, 960]"
                width="360"
                height="56"
                text="▼ PRESS OK TO READ MORE"
                color="0xFFA500FF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>
        </Group>

        <!-- =============== PORTRAIT METADATA (rotated, viewer-top strip) ===============
             Horizontal padding matches the portrait info chrome at the bottom: rating
             icon at 90px from the left, clock at 90px from the right. -->
        <Group id="portraitMetadata" visible="false" translation="[-360, 360]"
               rotation="1.5707963" scaleRotateCenter="[540, 180]">
            <Rectangle width="1080" height="360" color="0x000000FF" />
            <Label
                id="portraitMetaTagline"
                translation="[90, 40]"
                width="900"
                height="50"
                text=""
                color="0xFFA500FF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="35" />
            </Label>
            <Label
                id="portraitMetaStats"
                translation="[90, 106]"
                width="900"
                height="40"
                text=""
                color="0xFFFFFFCC"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="32" />
            </Label>
            <Label
                id="portraitMetaSummary"
                translation="[90, 170]"
                width="900"
                height="110"
                text=""
                color="0xE5E5E5FF"
                horizAlign="left"
                vertAlign="top"
                font="font:SmallestSystemFont"
                wrap="true" />
            <Label
                id="portraitMetaReadMoreHint"
                visible="false"
                translation="[90, 290]"
                width="900"
                height="46"
                text="▼ PRESS OK TO READ MORE"
                color="0xFFA500FF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="28" />
            </Label>
        </Group>

        <!-- App logo (landscape only, shown alongside info overlay) -->
        <Poster
            id="appLogo"
            uri="pkg:/images/logo-square.png"
            width="80"
            height="80"
            translation="[1820, 20]"
            loadDisplayMode="scaleToFit"
            visible="false" />

        <!-- Episode thumbnail overlay (TV episodes only, landscape modes) -->
        <Group id="episodePosterGroup" visible="false" translation="[40, 40]">
            <Rectangle width="208" height="121" color="0x000000DD" />
            <Poster
                id="episodePoster"
                translation="[4, 4]"
                width="200"
                height="113"
                loadDisplayMode="scaleToFit" />
        </Group>

        <!-- Title marquee (landscape only, over border's NOW PLAYING sign) -->
        <Group id="titleMarquee" visible="false" translation="[596, 919]">
            <Rectangle width="728" height="136" color="0x000000FF" />
            <Label
                id="titleMarqueeLabel"
                translation="[20, 18]"
                width="688"
                height="100"
                text=""
                color="0xFFEE00FF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/RetroSigned-DYYY0.ttf" size="72" />
            </Label>
        </Group>

        <!-- Blocked-ratings overlay (custom, full-screen, dimmed background) -->
        <Group id="blockedRatingsOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000EE" />
            <Rectangle width="900" height="850" translation="[510, 115]" color="0x1A1A1AFF" />
            <Label
                translation="[540, 140]"
                width="840"
                height="50"
                text="CAROUSEL: BLOCKED RATINGS"
                color="0xE0A030FF"
                horizAlign="left"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="34" />
            </Label>
            <Label
                translation="[540, 200]"
                width="840"
                height="80"
                text="Press OK to toggle each rating. Items with these ratings will be skipped in the random carousel. Press BACK to save and close."
                color="0xCCCCCCFF"
                horizAlign="left"
                vertAlign="top"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="22" />
            </Label>
            <CheckList
                id="blockedRatingsCheckList"
                translation="[540, 320]"
                itemSize="[840, 50]"
                numRows="10" />
        </Group>

        <!-- Plex sign-in overlay (plex.tv/link PIN flow). Shown after the user
             picks "Sign in with Plex" until they enter the code on plex.tv/link
             or press Back to cancel. -->
        <Group id="plexSignInOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000F2" />
            <Rectangle width="1100" height="780" translation="[410, 150]" color="0x1A1A1AFF" />
            <Label
                translation="[440, 200]"
                width="1040"
                height="56"
                text="SIGN IN WITH PLEX"
                color="0xE0A030FF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="42" />
            </Label>
            <Label
                translation="[440, 280]"
                width="1040"
                height="44"
                text="On a phone or computer, go to:"
                color="0xCCCCCCFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="28" />
            </Label>
            <Label
                translation="[440, 330]"
                width="1040"
                height="60"
                text="plex.tv/link"
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="50" />
            </Label>
            <Label
                translation="[440, 420]"
                width="1040"
                height="44"
                text="and enter this code:"
                color="0xCCCCCCFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="28" />
            </Label>
            <Label
                id="plexSignInCodeLabel"
                translation="[440, 480]"
                width="1040"
                height="160"
                text=""
                color="0xFFD700FF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="140" />
            </Label>
            <Label
                id="plexSignInStatusLabel"
                translation="[440, 680]"
                width="1040"
                height="44"
                text="Waiting for authorization..."
                color="0x9A9A9AFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="24" />
            </Label>
            <Label
                translation="[440, 850]"
                width="1040"
                height="44"
                text="Press BACK to cancel"
                color="0x5A5A5AFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="20" />
            </Label>
        </Group>

        <!-- Expanded description ("Read more"). Full-screen modal opened with OK
             while the metadata overlay is visible. Pauses the carousel while open;
             Back closes it. -->
        <Group id="expandedDescription" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000FF" />
            <!-- Subtle blurred-poster backdrop — URI is set to the current
                 backgroundPoster URI when the modal opens. Low opacity layers
                 the artwork over the black for a soft, themed feel. -->
            <Poster
                id="expandedBackdrop"
                width="1920"
                height="1080"
                translation="[0, 0]"
                opacity="0.25"
                loadDisplayMode="zoomToFill" />
            <Label
                id="expandedTitle"
                translation="[200, 50]"
                width="1520"
                height="100"
                text=""
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="76" />
            </Label>
            <!-- Tagline / slogan — BebasNeue, accent color, wraps if long -->
            <Label
                id="expandedTagline"
                translation="[200, 175]"
                width="1520"
                height="80"
                text=""
                color="0xFFA500FF"
                horizAlign="center"
                vertAlign="top"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="38" />
            </Label>

            <!-- Stats box: Oswald-Medium inside a white-outlined rectangle. -->
            <Rectangle translation="[560, 275]" width="800" height="2" color="0xFFFFFFFF" />
            <Rectangle translation="[560, 353]" width="800" height="2" color="0xFFFFFFFF" />
            <Rectangle translation="[560, 275]" width="2" height="80" color="0xFFFFFFFF" />
            <Rectangle translation="[1358, 275]" width="2" height="80" color="0xFFFFFFFF" />
            <Label
                id="expandedStats"
                translation="[580, 275]"
                width="760"
                height="80"
                text=""
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Medium.ttf" size="28" />
            </Label>

            <!-- Credit lines: accent-bold label + white value side by side -->
            <Label id="expandedDirectorLabel"
                   translation="[200, 380]" width="200" height="32" text="Director:"
                   color="0xFFA500FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallBoldSystemFont" />
            <Label id="expandedDirectorValue"
                   translation="[420, 380]" width="1300" height="32" text=""
                   color="0xE5E5E5FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallSystemFont" />
            <Label id="expandedWriterLabel"
                   translation="[200, 418]" width="200" height="32" text="Writer:"
                   color="0xFFA500FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallBoldSystemFont" />
            <Label id="expandedWriterValue"
                   translation="[420, 418]" width="1300" height="32" text=""
                   color="0xE5E5E5FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallSystemFont" />
            <Label id="expandedCastLabel"
                   translation="[200, 456]" width="200" height="32" text="Starring:"
                   color="0xFFA500FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallBoldSystemFont" />
            <Label id="expandedCastValue"
                   translation="[420, 456]" width="1300" height="32" text=""
                   color="0xE5E5E5FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallSystemFont" />
            <Label id="expandedStudioLabel"
                   translation="[200, 494]" width="200" height="32" text="Studio:"
                   color="0xFFA500FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallBoldSystemFont" />
            <Label id="expandedStudioValue"
                   translation="[420, 494]" width="1300" height="32" text=""
                   color="0xE5E5E5FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallSystemFont" />
            <Label id="expandedReleasedLabel"
                   translation="[200, 532]" width="200" height="32" text="Released:"
                   color="0xFFA500FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallBoldSystemFont" />
            <Label id="expandedReleasedValue"
                   translation="[420, 532]" width="1300" height="32" text=""
                   color="0xE5E5E5FF" horizAlign="left" vertAlign="center" wrap="false"
                   font="font:SmallSystemFont" />

            <!-- Horizontal separator between credits and description -->
            <Rectangle translation="[200, 590]" width="1520" height="2" color="0x80808066" />

            <!-- Summary / description -->
            <Label
                id="expandedSummary"
                translation="[200, 610]"
                width="1520"
                height="150"
                text=""
                color="0xE5E5E5FF"
                horizAlign="left"
                vertAlign="top"
                lineSpacing="10"
                font="font:SmallSystemFont"
                wrap="true" />

            <!-- ===== Ratings: 4 bordered boxes, each w=360 h=140, gap=20 ===== -->
            <!-- PLEX -->
            <Group translation="[210, 790]">
                <Rectangle translation="[0, 0]" width="360" height="2" color="0xFFFFFF40" />
                <Rectangle translation="[0, 138]" width="360" height="2" color="0xFFFFFF40" />
                <Rectangle translation="[0, 0]" width="2" height="140" color="0xFFFFFF40" />
                <Rectangle translation="[358, 0]" width="2" height="140" color="0xFFFFFF40" />
                <Label translation="[0, 18]" width="360" height="30" text="PLEX"
                       color="0xCCCCCCFF" horizAlign="center" vertAlign="center"
                       font="font:SmallBoldSystemFont" />
                <Rectangle id="ratingPlexUnderline" translation="[160, 56]" width="40" height="3" color="0xFFA500FF" />
                <Label id="ratingPlexValue" translation="[0, 66]" width="360" height="64" text="—"
                       color="0xFFA500FF" horizAlign="center" vertAlign="center" wrap="false">
                    <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="48" />
                </Label>
            </Group>
            <!-- IMDB -->
