<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterDisplayScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/PosterDisplayScene.brs" />
    <children>
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="0x000000FF" />

        <Poster
            id="backgroundPoster"
            width="1920"
            height="1080"
            translation="[0,0]"
            loadDisplayMode="zoomToFill"
            opacity="0.18"
            visible="false" />

        <!-- Optional black matte rendered behind the portrait poster (no-theater-frame
             modes only). Four rects so each side can be individually hidden — when info
             is on, the viewer-bottom side hides because the chrome strip already provides
             that black band. Geometry set in BRS to follow the poster's rotation + center. -->
        <Group id="portraitPosterBorderGroup" visible="false">
            <Rectangle id="portraitPosterBorderTop" color="0x000000FF" />
            <Rectangle id="portraitPosterBorderBottom" color="0x000000FF" />
            <Rectangle id="portraitPosterBorderLeft" color="0x000000FF" />
            <Rectangle id="portraitPosterBorderRight" color="0x000000FF" />
        </Group>

        <Poster
            id="poster"
            width="1920"
            height="1080"
            translation="[0,0]"
            loadDisplayMode="scaleToFit" />

        <Poster
            id="borderLandscape"
            uri="pkg:/images/borders/landscape/landscape-border-01.png"
            width="1920"
            height="1080"
            translation="[0,0]"
            visible="false"
            loadDisplayMode="scaleToFill" />

        <Poster
            id="borderPortrait"
            uri="pkg:/images/borders/portrait/portrait-border-01.png"
            width="1920"
            height="1080"
            translation="[0,0]"
            visible="false"
            loadDisplayMode="scaleToFill" />

        <!-- =============== LANDSCAPE INFO STRIP (left side, vertical) ===============
             400px-wide solid-black strip pinned to the left of the screen. Mirrors
             the metadata strip on the right. Stacks (top to bottom): rating icon,
             title, year, then later in the strip: clock, time row, progress bar. -->
        <Group id="landscapeChrome">
            <Rectangle id="overlay" width="400" height="1080" color="0x000000FF" />

            <!-- Rating icon (top, centered horizontally) -->
            <Poster
                id="ratingIcon"
                visible="false"
                translation="[170, 50]"
                width="60"
                height="60"
                opacity="0.9"
                loadDisplayMode="scaleToFit" />
            <!-- Text rating prefix (used only when no PNG icon is available) -->
            <Label
                id="nowPlayingPrefix"
                visible="false"
                translation="[20, 50]"
                width="360"
                height="60"
                text=""
                color="0xFFFFFFCC"
                horizAlign="center"
                vertAlign="center"
                font="font:LargeBoldSystemFont" />

            <!-- Title (wraps; centered in strip) -->
            <Label
                id="nowPlayingTitle"
                visible="false"
                translation="[20, 140]"
                width="360"
                height="180"
                text=""
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="top"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="36" />
            </Label>

            <!-- Year (below title) -->
            <Label
                id="nowPlayingYear"
                visible="false"
                translation="[20, 340]"
                width="360"
                height="44"
                text=""
                color="0xFFFFFFCC"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="36" />
            </Label>

            <!-- "Waiting for Plex" / setup prompt (replaces title row when not playing) -->
            <Label
                id="messageLabel"
                translation="[20, 460]"
                width="360"
                height="160"
                text="Waiting for Plex"
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>

            <!-- Clock (large, centered, lower portion of strip) -->
            <Label
                id="clockLabel"
                translation="[20, 700]"
                width="360"
                height="80"
                text=""
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="72" />
            </Label>

            <!-- Progress: current time on left, total on right, bar below -->
            <Group id="progressGroup" visible="false" translation="[20, 820]">
                <Label
                    id="currentTimeLabel"
                    translation="[0, 0]"
                    width="170"
                    height="40"
                    text="0:00:00"
                    color="0xFFFFFFFF"
                    horizAlign="left"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="30" />
                </Label>
                <Label
                    id="totalTimeLabel"
                    translation="[190, 0]"
                    width="170"
                    height="40"
                    text="0:00:00"
                    color="0xFFFFFFFF"
                    horizAlign="right"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="30" />
                </Label>
                <Rectangle translation="[0, 50]" width="360" height="8" color="0x666666FF" />
                <Rectangle id="progressBarFill" translation="[0, 50]" width="1" height="8" color="0xFFA500FF" />
            </Group>

            <!-- Settings icon (still pinned to the screen's top-right corner) -->
            <Rectangle width="60" height="60" translation="[1840, 20]" color="0x000000FF" />
            <Button
                id="settingsButton"
                translation="[1840, 20]"
                minWidth="60"
                height="60"
                text="≡"
                textColor="0xFFD700FF"
                focusedTextColor="0xFFEE00FF"
                showFocusFootprint="false">
                <Font role="textFont" uri="pkg:/fonts/Oswald-Bold.ttf" size="36" />
            </Button>
        </Group>

        <!-- =============== PORTRAIT CHROME (rotated) =============== -->
        <Group id="portraitChrome" visible="false" translation="[1265, 425]"
               rotation="1.5707963" scaleRotateCenter="[540, 115]">
            <!-- 1080x230 pre-rotation; becomes 230x1080 buffer-edge strip; viewer sees as bottom 230 of vertical screen -->
            <Rectangle width="1080" height="230" color="0x000000FF" />

            <!-- Progress bar (top of strip in viewer). Layout:
                 [current] [ bar ] [total]   plus a sibling clock label below. -->
            <Group id="portraitProgressGroup" visible="false" translation="[0, 50]">
                <Label
                    id="portraitCurrentTimeLabel"
                    translation="[90, 0]"
                    width="90"
                    height="32"
                    text="0:00"
                    color="0xFFFFFFFF"
                    horizAlign="left"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
                </Label>
                <Rectangle translation="[200, 12]" width="690" height="8" color="0x666666FF" />
                <Rectangle id="portraitProgressBarFill" translation="[200, 12]" width="1" height="8" color="0xFFA500FF" />
                <Label
                    id="portraitTotalTimeLabel"
                    translation="[900, 0]"
                    width="90"
                    height="32"
                    text="0:00"
                    color="0xFFFFFFFF"
                    horizAlign="right"
                    vertAlign="center">
                    <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
                </Label>
            </Group>

            <!-- Status (centered in strip when shown alone). When playing+info, the
                 now-playing row + clock sit at y=132 (vertically centered as a group
                 with the progress bar above); the message label hides. -->
            <Label
                id="portraitMessageLabel"
                translation="[20, 91]"
                width="1040"
                height="48"
                text="Waiting for Plex"
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>
            <Label
                id="portraitNowPlayingPrefix"
                visible="false"
                translation="[20, 132]"
                width="120"
                height="48"
                text=""
                color="0xFFFFFFCC"
                horizAlign="left"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>
            <Poster
                id="portraitRatingIcon"
                visible="false"
                translation="[20, 132]"
                width="72"
                height="48"
                opacity="0.85"
                loadDisplayMode="scaleToFit" />
            <Label
                id="portraitNowPlayingTitle"
                visible="false"
                translation="[150, 132]"
                width="640"
                height="48"
                text=""
                color="0xFFFFFFFF"
                horizAlign="left"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="32" />
            </Label>
            <Label
                id="portraitNowPlayingYear"
                visible="false"
                translation="[150, 132]"
                width="160"
                height="48"
                text=""
                color="0xFFFFFFCC"
                horizAlign="left"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
            </Label>
            <Label
                id="portraitClockLabel"
                translation="[790, 132]"
                width="200"
                height="48"
                text=""
                color="0xFFFFFFFF"
                horizAlign="right"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="32" />
            </Label>

            <!-- Settings icon (right side of strip in viewer) -->
            <Rectangle id="portraitSettingsButtonBg" width="60" height="60" translation="[1010, 126]" color="0x000000FF" />
            <Button
                id="portraitSettingsButton"
                translation="[1010, 126]"
                minWidth="60"
                height="60"
                text="≡"
                textColor="0xFFD700FF"
                focusedTextColor="0xFFEE00FF"
                showFocusFootprint="false">
                <Font role="textFont" uri="pkg:/fonts/Oswald-Bold.ttf" size="36" />
            </Button>
        </Group>

        <!-- =============== LANDSCAPE METADATA (right-side vertical strip) ===============
             Cleaned up: just slogan, condensed stats, director, and a description
             block with a generous gap above so it doesn't feel cluttered. -->
        <Group id="landscapeMetadata" visible="false" translation="[1520, 0]">
            <Rectangle width="400" height="1080" color="0x000000FF" />
            <!-- Slogan / tagline (accent color, uppercase, Oswald Bold) -->
            <Label
                id="landscapeMetaTagline"
                translation="[30, 40]"
                width="340"
                height="120"
                text=""
                color="0xFFA500FF"
                horizAlign="left"
                vertAlign="top"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="30" />
            </Label>
            <!-- Year · Runtime · Genres in the time-label font + 80% opacity -->
            <Label
                id="landscapeMetaStats"
                translation="[30, 200]"
                width="340"
                height="40"
                text=""
                color="0xFFFFFFCC"
                horizAlign="left"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="30" />
            </Label>
            <!-- Director (same font / opacity as stats) -->
            <Label
                id="landscapeMetaDirector"
                translation="[30, 244]"
                width="340"
                height="40"
                text=""
                color="0xFFFFFFCC"
                horizAlign="left"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="30" />
            </Label>
            <!-- Description (smaller body font, generous top gap from director) -->
            <Label
                id="landscapeMetaSummary"
                translation="[30, 350]"
                width="340"
                height="700"
                text=""
                color="0xE5E5E5FF"
                horizAlign="left"
                vertAlign="top"
                font="font:SmallSystemFont"
                wrap="true" />
        </Group>

        <!-- =============== PORTRAIT METADATA (rotated, viewer-top strip) ===============
             Same simplified layout as landscape, condensed for the 360-tall strip. -->
        <Group id="portraitMetadata" visible="false" translation="[-360, 360]"
               rotation="1.5707963" scaleRotateCenter="[540, 180]">
            <Rectangle width="1080" height="360" color="0x000000FF" />
            <Label
                id="portraitMetaTagline"
                translation="[60, 25]"
                width="960"
                height="40"
                text=""
                color="0xFFA500FF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="28" />
            </Label>
            <Label
                id="portraitMetaStats"
                translation="[60, 78]"
                width="960"
                height="34"
                text=""
                color="0xFFFFFFCC"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
            </Label>
            <Label
                id="portraitMetaDirector"
                translation="[60, 118]"
                width="960"
                height="34"
                text=""
                color="0xFFFFFFCC"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/BebasNeue-Regular.ttf" size="28" />
            </Label>
            <Label
                id="portraitMetaSummary"
                translation="[60, 200]"
                width="960"
                height="150"
                text=""
                color="0xE5E5E5FF"
                horizAlign="center"
                vertAlign="top"
                font="font:SmallSystemFont"
                wrap="true" />
        </Group>

        <!-- App logo (landscape only, shown alongside info overlay) -->
        <Poster
            id="appLogo"
            uri="pkg:/images/logo-square.png"
            width="80"
            height="80"
            translation="[1820, 20]"
            loadDisplayMode="scaleToFit"
            visible="false" />

        <!-- Episode thumbnail overlay (TV episodes only, landscape modes) -->
        <Group id="episodePosterGroup" visible="false" translation="[40, 40]">
            <Rectangle width="208" height="121" color="0x000000DD" />
            <Poster
                id="episodePoster"
                translation="[4, 4]"
                width="200"
                height="113"
                loadDisplayMode="scaleToFit" />
        </Group>

        <!-- Title marquee (landscape only, over border's NOW PLAYING sign) -->
        <Group id="titleMarquee" visible="false" translation="[596, 919]">
            <Rectangle width="728" height="136" color="0x000000FF" />
            <Label
                id="titleMarqueeLabel"
                translation="[20, 18]"
                width="688"
                height="100"
                text=""
                color="0xFFEE00FF"
                horizAlign="center"
                vertAlign="center"
                wrap="false">
                <Font role="font" uri="pkg:/fonts/RetroSigned-DYYY0.ttf" size="72" />
            </Label>
        </Group>

        <!-- Blocked-ratings overlay (custom, full-screen, dimmed background) -->
        <Group id="blockedRatingsOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000EE" />
            <Rectangle width="900" height="850" translation="[510, 115]" color="0x1A1A1AFF" />
            <Label
                translation="[540, 140]"
                width="840"
                height="50"
                text="CAROUSEL: BLOCKED RATINGS"
                color="0xE0A030FF"
                horizAlign="left"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="34" />
            </Label>
            <Label
                translation="[540, 200]"
                width="840"
                height="80"
                text="Press OK to toggle each rating. Items with these ratings will be skipped in the random carousel. Press BACK to save and close."
                color="0xCCCCCCFF"
                horizAlign="left"
                vertAlign="top"
                wrap="true">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="22" />
            </Label>
            <CheckList
                id="blockedRatingsCheckList"
                translation="[540, 320]"
                itemSize="[840, 50]"
                numRows="10" />
        </Group>

        <!-- Plex sign-in overlay (plex.tv/link PIN flow). Shown after the user
             picks "Sign in with Plex" until they enter the code on plex.tv/link
             or press Back to cancel. -->
        <Group id="plexSignInOverlay" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000F2" />
            <Rectangle width="1100" height="780" translation="[410, 150]" color="0x1A1A1AFF" />
            <Label
                translation="[440, 200]"
                width="1040"
                height="56"
                text="SIGN IN WITH PLEX"
                color="0xE0A030FF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="42" />
            </Label>
            <Label
                translation="[440, 280]"
                width="1040"
                height="44"
                text="On a phone or computer, go to:"
                color="0xCCCCCCFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="28" />
            </Label>
            <Label
                translation="[440, 330]"
                width="1040"
                height="60"
                text="plex.tv/link"
                color="0xFFFFFFFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="50" />
            </Label>
            <Label
                translation="[440, 420]"
                width="1040"
                height="44"
                text="and enter this code:"
                color="0xCCCCCCFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="28" />
            </Label>
            <Label
                id="plexSignInCodeLabel"
                translation="[440, 480]"
                width="1040"
                height="160"
                text=""
                color="0xFFD700FF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="140" />
            </Label>
            <Label
                id="plexSignInStatusLabel"
                translation="[440, 680]"
                width="1040"
                height="44"
                text="Waiting for authorization..."
                color="0x9A9A9AFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="24" />
            </Label>
            <Label
                translation="[440, 850]"
                width="1040"
                height="44"
                text="Press BACK to cancel"
                color="0x5A5A5AFF"
                horizAlign="center"
                vertAlign="center">
                <Font role="font" uri="pkg:/fonts/Oswald-Bold.ttf" size="20" />
            </Label>
        </Group>

        <Group id="modeIndicator" visible="false" translation="[60,60]">
            <Rectangle width="800" height="80" color="0x000000DD" />
            <Label
                id="modeIndicatorLabel"
                translation="[20,20]"
                width="760"
                height="40"
                text=""
                color="0xFFFFFFFF"
                font="font:MediumBoldSystemFont"
                horizAlign="center"
                vertAlign="center" />
        </Group>

        <Timer id="pollTimer" duration="15" repeat="true" />
        <Timer id="hideIndicatorTimer" duration="3" repeat="false" />
        <Timer id="plexSignInPollTimer" duration="3" repeat="true" />
        <Timer id="tickTimer" duration="1" repeat="true" />
        <Timer id="carouselTimer" duration="30" repeat="true" />

        <!-- Poster transition animations. The main poster's opacity (fade) and
             translation (slide) are animated; URI swap happens in the BRS
             handler between the "out" and "in" animations. -->
        <Animation id="posterFadeOut" duration="0.3" easeFunction="linear">
            <FloatFieldInterpolator
                fieldToInterp="poster.opacity"
                key="[0.0, 1.0]"
                keyValue="[1.0, 0.0]" />
            <FloatFieldInterpolator
                fieldToInterp="backgroundPoster.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.18, 0.0]" />
        </Animation>
        <Animation id="posterFadeIn" duration="0.3" easeFunction="linear">
            <FloatFieldInterpolator
                fieldToInterp="poster.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.0, 1.0]" />
            <FloatFieldInterpolator
                fieldToInterp="backgroundPoster.opacity"
                key="[0.0, 1.0]"
                keyValue="[0.0, 0.18]" />
        </Animation>
        <Animation id="posterSlideOut" duration="0.4" easeFunction="inQuad">
            <Vector2DFieldInterpolator
                id="posterSlideOutInterp"
                fieldToInterp="poster.translation"
                key="[0.0, 1.0]"
                keyValue="[[0,0], [-2000,0]]" />
        </Animation>
        <Animation id="posterSlideIn" duration="0.4" easeFunction="outQuad">
            <Vector2DFieldInterpolator
                id="posterSlideInInterp"
                fieldToInterp="poster.translation"
                key="[0.0, 1.0]"
                keyValue="[[2000,0], [0,0]]" />
        </Animation>
    </children>
</component>
